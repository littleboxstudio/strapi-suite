{
  "kind": "collectionType",
  "collectionName": "ltb_st_module_ecommerce_products",
  "info": {
    "singularName": "ltb-st-module-ecommerce-product",
    "pluralName": "ltb-st-module-ecommerce-products",
    "displayName": "Littlebox Strapi Suite - E-commerce Product",
    "description": "Model for managing Littlebox Strapi Suite E-commerce Product"
  },
  "options": {
    "draftAndPublish": false,
    "comment": ""
  },
  "attributes": {
    "active": {
      "type": "boolean",
      "default": true
    },
    "translations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::littlebox-strapi-suite.ltb-st-module-ecommerce-product-translation",
      "mappedBy": "product"
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::littlebox-strapi-suite.ltb-st-module-ecommerce-variant",
      "mappedBy": "product"
    },
    "images": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::littlebox-strapi-suite.ltb-st-module-ecommerce-image",
      "mappedBy": "product"
    }
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    },
    "i18n": {
      "localized": false
    }
  }
}
