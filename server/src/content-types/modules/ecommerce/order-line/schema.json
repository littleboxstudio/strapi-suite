    },
    "name": {
      "type": "string"
    },
    "option": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "unitPrice": {
      "type": "integer"
    },
    "unitDiscount": {
      "type": "integer",
