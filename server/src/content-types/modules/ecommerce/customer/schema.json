{
  "kind": "collectionType",
  "collectionName": "ltb_st_module_ecommerce_customers",
  "info": {
    "singularName": "ltb-st-module-ecommerce-customer",
    "pluralName": "ltb-st-module-ecommerce-customers",
    "displayName": "Littlebox Strapi Suite - E-commerce Customer",
    "description": "Model for managing Littlebox Strapi Suite E-commerce Customer"
  },
  "options": {
    "draftAndPublish": false,
    "comment": ""
  },
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "emailNormalized": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "accountType": {
      "type": "enumeration",
      "enum": [
        "GUEST",
        "REGISTERED"
      ],
      "default": "GUEST"
    },
    "emailVerified": {
      "type": "boolean",
      "default": false
    },
    "emailVerifiedAt": {
      "type": "datetime"
    },
    "passwordHash": {
      "type": "string",
      "private": true
    },
    "passwordPepperVersion": {
      "type": "integer"
    },
    "passwordChangedAt": {
      "type": "datetime"
    },
    "pendingEmail": {
      "type": "string"
    },
    "pendingEmailNormalized": {
      "type": "string"
    },
    "blocked": {
      "type": "boolean",
      "default": false
    },
    "blockedAt": {
      "type": "datetime"
    },
    "blockedNote": {
      "type": "text"
    },
    "blockedById": {
      "type": "integer"
    },
    "cart": {
      "type": "json"
    },
    "orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::littlebox-strapi-suite.ltb-st-module-ecommerce-order",
      "mappedBy": "customer"
    }
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    },
    "i18n": {
      "localized": false
    }
  },
  "indexes": [
    {
      "name": "ecommerce_customer_email_idx",
      "columns": [
        "email_normalized"
      ]
    },
    {
      "name": "ecommerce_customer_pending_email_idx",
      "columns": [
        "pending_email_normalized"
      ]
    },
    {
      "name": "ecommerce_customer_blocked_type_idx",
      "columns": [
        "blocked",
        "account_type"
      ]
    }
  ]
}
