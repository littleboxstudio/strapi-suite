{
  "kind": "collectionType",
  "collectionName": "ltb_st_module_ecommerce_payments",
  "info": {
    "singularName": "ltb-st-module-ecommerce-payment",
    "pluralName": "ltb-st-module-ecommerce-payments",
    "displayName": "Littlebox Strapi Suite - E-commerce Payment",
    "description": "Model for managing Littlebox Strapi Suite E-commerce Payment"
  },
  "options": {
    "draftAndPublish": false,
    "comment": ""
  },
  "attributes": {
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::littlebox-strapi-suite.ltb-st-module-ecommerce-order",
      "inversedBy": "payments"
    },
    "method": {
      "type": "enumeration",
      "enum": [
        "STRIPE",
        "MANUAL",
        "STORE_CREDIT"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "PENDING",
        "COMPLETED",
        "CANCELLED",
        "FAILED"
      ]
    },
    "amount": {
      "type": "integer",
      "required": true
    },
    "currency": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "externalId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string",
      "unique": true
    },
    "coverage": {
      "type": "json"
    },
    "completedAt": {
      "type": "datetime"
    },
    "actor": {
      "type": "string"
    },
    "metadata": {
      "type": "json"
    }
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    },
    "i18n": {
      "localized": false
    }
  },
  "indexes": [
    {
      "name": "ecommerce_payment_idempotency_key_unique",
      "columns": [
        "idempotency_key"
      ],
      "type": "unique"
    }
  ]
}
